<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="HeladeriaPOS.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BrandRed">#C2185B</Color>
            <Color x:Key="BrandDarkRed">#8E1244</Color>
            <Color x:Key="CheckoutGreen">#147D5B</Color>
            <Color x:Key="PageBackground">#FFF8FA</Color>
            <Color x:Key="PanelBackground">#FFF1F5</Color>
            <Color x:Key="SoftBorder">#F0DDE4</Color>
            <Color x:Key="TextPrimary">#2B1720</Color>
            <Color x:Key="TextSecondary">#745A64</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="TouchButtonStyle" TargetType="Button">
                <Setter Property="MinimumHeightRequest" Value="54" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="#EAD5DD" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#220F0710" Offset="0,3" Radius="8" Opacity="0.55" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
                <Setter Property="MinimumWidthRequest" Value="140" />
                <Setter Property="MinimumHeightRequest" Value="68" />
                <Setter Property="BackgroundColor" Value="#FFF4F7" />
                <Setter Property="TextColor" Value="{StaticResource BrandRed}" />
                <Setter Property="BorderColor" Value="#EBA8BD" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>

            <Style x:Key="QuantityButtonStyle" TargetType="Button">
                <Setter Property="WidthRequest" Value="52" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="#FFF9FB" />
                <Setter Property="TextColor" Value="#512334" />
                <Setter Property="BorderColor" Value="#E7C6D2" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#180F0710" Offset="0,2" Radius="5" Opacity="0.5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuickCashButtonStyle" TargetType="Button">
                <Setter Property="MinimumWidthRequest" Value="86" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="#FFF9FB" />
                <Setter Property="TextColor" Value="#512334" />
                <Setter Property="BorderColor" Value="#E7C6D2" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#16000000" Offset="0,2" Radius="5" Opacity="0.6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TouchEntryStyle" TargetType="Entry">
                <Setter Property="MinimumHeightRequest" Value="54" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#222222" />
                <Setter Property="PlaceholderColor" Value="#9A9A9A" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="TouchRadioStyle" TargetType="RadioButton">
                <Setter Property="MinimumHeightRequest" Value="46" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="#2B2B2B" />
            </Style>

            <Style x:Key="TouchCheckStyle" TargetType="CheckBox">
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
