<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="HeladeriaPOS.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BrandRed">#B80035</Color>
            <Color x:Key="BrandDarkRed">#920028</Color>
            <Color x:Key="CheckoutGreen">#006C4A</Color>
            <Color x:Key="PageBackground">#FAF8FF</Color>
            <Color x:Key="PanelBackground">#F2F3FF</Color>
            <Color x:Key="SoftBorder">#E8E9F3</Color>
            <Color x:Key="TextPrimary">#131B2E</Color>
            <Color x:Key="TextSecondary">#5C6477</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="TouchButtonStyle" TargetType="Button">
                <Setter Property="MinimumHeightRequest" Value="54" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="#DDDDEA" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#24000000" Offset="0,3" Radius="7" Opacity="0.7" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
                <Setter Property="MinimumWidthRequest" Value="140" />
                <Setter Property="MinimumHeightRequest" Value="68" />
                <Setter Property="BackgroundColor" Value="#FFF0F3" />
                <Setter Property="TextColor" Value="{StaticResource BrandRed}" />
                <Setter Property="BorderColor" Value="#FFC2D0" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>

            <Style x:Key="QuantityButtonStyle" TargetType="Button">
                <Setter Property="WidthRequest" Value="52" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="#F2F4F6" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="BorderColor" Value="#D8DDE2" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#18000000" Offset="0,2" Radius="5" Opacity="0.6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuickCashButtonStyle" TargetType="Button">
                <Setter Property="MinimumWidthRequest" Value="86" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#283044" />
                <Setter Property="BorderColor" Value="#E2E7FF" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#16000000" Offset="0,2" Radius="5" Opacity="0.6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TouchEntryStyle" TargetType="Entry">
                <Setter Property="MinimumHeightRequest" Value="54" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#222222" />
                <Setter Property="PlaceholderColor" Value="#9A9A9A" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="TouchRadioStyle" TargetType="RadioButton">
                <Setter Property="MinimumHeightRequest" Value="46" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="#2B2B2B" />
            </Style>

            <Style x:Key="TouchCheckStyle" TargetType="CheckBox">
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
