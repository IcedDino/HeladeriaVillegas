<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HeladeriaPOS.Views.RespaldoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource PageBackground}">
    <ContentPage.Resources>
        <Style x:Key="SectionCaption" TargetType="Label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="12" Padding="18,16">
        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="1">
                <Label Text="Respaldo de datos" FontSize="27" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
                <Label Text="Protege la base de ventas de tu negocio" FontSize="13" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="×" Clicked="OnCloseClicked" WidthRequest="52" HeightRequest="52"
                    CornerRadius="26" Padding="0" FontSize="26" BackgroundColor="#FFF0F3" TextColor="{StaticResource BrandDarkRed}"
                    SemanticProperties.Description="Cerrar respaldo" />
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="12">
                <!-- Estado -->
                <Border Padding="16" BackgroundColor="#FDF2F6" Stroke="#F3D9E2" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="ESTADO DE LA BASE DE DATOS" Style="{StaticResource SectionCaption}" />
                        <Label Text="La aplicación crea una copia automática cada día al abrirla." FontSize="14" TextColor="{StaticResource TextPrimary}" />
                        <Label x:Name="AutoBackupLabel" FontSize="13" TextColor="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Último respaldo -->
                <Border Padding="16" BackgroundColor="White" Stroke="{StaticResource SoftBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ÚLTIMO RESPALDO" Style="{StaticResource SectionCaption}" />
                        <Label x:Name="LastBackupLabel" Text="Aún no hay respaldos." FontSize="16" FontAttributes="Bold" TextColor="{StaticResource BrandDarkRed}" LineBreakMode="WordWrap" />
                        <Label x:Name="BackupPathLabel" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Crear respaldo -->
                <Border Padding="16" BackgroundColor="#EAF7F1" Stroke="#BBDCCC" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="CREAR RESPALDO AHORA" Style="{StaticResource SectionCaption}" />
                        <Label Text="Genera una copia verificada de todas las ventas, precios y productos." FontSize="14" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" />
                        <Button Text="Crear respaldo" Clicked="OnCreateBackupClicked" HeightRequest="58" CornerRadius="14"
                                FontSize="17" FontAttributes="Bold" BackgroundColor="{StaticResource CheckoutGreen}" TextColor="White"
                                SemanticProperties.Description="Crear un respaldo de la base de datos" />
                        <Label x:Name="CreateResultLabel" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- Restaurar -->
                <Border Padding="16" BackgroundColor="White" Stroke="{StaticResource SoftBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="RESTAURAR RESPALDO" Style="{StaticResource SectionCaption}" />
                        <Label Text="Reemplaza la base actual por una copia. Se conserva una copia de la base anterior y la restauración se aplica al reiniciar." FontSize="14" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" />
                        <Button Text="Restaurar respaldo" Clicked="OnRestoreBackupClicked" HeightRequest="58" CornerRadius="14"
                                FontSize="17" FontAttributes="Bold" BackgroundColor="#FFF0F3" TextColor="{StaticResource BrandDarkRed}"
                                BorderColor="#EBA8BD" BorderWidth="1"
                                SemanticProperties.Description="Restaurar la base a partir de un respaldo" />
                        <Label x:Name="RestoreResultLabel" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Consejo: copia los respaldos a una USB o a la nube para protegerlos si falla esta computadora."
                       FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="0,0,0,8" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>