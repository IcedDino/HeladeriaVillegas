<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HeladeriaPOS.Views.SplashPage"
             BackgroundColor="#FFF7F9"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto,*" Padding="24">
        <VerticalStackLayout Grid.Row="1" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
            <Grid WidthRequest="360" HeightRequest="300">
                <WebView x:Name="SplashWebView" HorizontalOptions="Fill" VerticalOptions="Fill"
                         BackgroundColor="#FFF7F9" />
                <BoxView x:Name="RendererCover" Color="#FFF7F9" InputTransparent="True" />
            </Grid>
            <Label x:Name="SplashTitle" Opacity="0" Text="HELADERÍA VILLEGAS" TextColor="#633B48" FontSize="24"
                   FontAttributes="Bold" CharacterSpacing="2" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
