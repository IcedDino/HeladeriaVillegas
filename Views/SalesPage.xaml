<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HeladeriaPOS.Views.SalesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HeladeriaPOS.Views"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource PageBackground}">
    <ContentPage.Resources>
        <Style x:Key="SectionCaption" TargetType="Label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Padding="18,16">
        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="1">
                <Label Text="Ventas y corte" FontSize="27" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
                <Label Text="Consulta las ventas por día" FontSize="13" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="×" Clicked="OnCloseClicked" WidthRequest="52" HeightRequest="52"
                    CornerRadius="26" Padding="0" FontSize="26" BackgroundColor="#FFF0F3" TextColor="{StaticResource BrandDarkRed}"
                    SemanticProperties.Description="Cerrar ventas" />
        </Grid>

        <!-- Date selector -->
        <Border Grid.Row="1" Padding="14,10" BackgroundColor="White" Stroke="{StaticResource SoftBorder}" StrokeThickness="1"
                StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border WidthRequest="44" HeightRequest="44" BackgroundColor="#FDF2F6" StrokeThickness="0" StrokeShape="RoundRectangle 11">
                    <Label Text="🗓" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="DÍA DE VENTA" Style="{StaticResource SectionCaption}" />
                    <DatePicker x:Name="SalesDatePicker" Format="dddd d 'de' MMMM, yyyy" FontSize="16" FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" HeightRequest="36" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="Hoy" Clicked="OnTodayClicked" HeightRequest="42" VerticalOptions="Center"
                        Style="{StaticResource QuickCashButtonStyle}" BackgroundColor="#EAF7F1" TextColor="{StaticResource CheckoutGreen}"
                        BorderColor="#BBDCCC" />
            </Grid>
        </Border>

        <!-- Summary cards -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,*,*" ColumnSpacing="10">
            <Border Padding="12,10" BackgroundColor="#FDF2F6" Stroke="#F3D9E2" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="1">
                    <Label Text="TOTAL DEL DÍA" Style="{StaticResource SectionCaption}" />
                    <Label x:Name="TotalDayLabel" Text="$0" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource BrandDarkRed}" />
                    <Label x:Name="CountLabel" Text="0 ventas" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Padding="12,10" BackgroundColor="#F2F3FF" Stroke="#DAE2FD" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="1">
                    <Label Text="EFECTIVO" Style="{StaticResource SectionCaption}" />
                    <Label x:Name="CashLabel" Text="$0" FontSize="18" FontAttributes="Bold" TextColor="#3A4BC0" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Padding="12,10" BackgroundColor="#EAF7F1" Stroke="#BBDCCC" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="1">
                    <Label Text="TARJETA + TRANSF." Style="{StaticResource SectionCaption}" />
                    <Label x:Name="CardLabel" Text="$0" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource CheckoutGreen}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Ticket list -->
        <CollectionView x:Name="TicketsList" Grid.Row="3" SelectionMode="None" VerticalScrollBarVisibility="Never"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="10" Padding="0,40" VerticalOptions="Center">
                    <Label Text="No hay ventas este día" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    <Label Text="Registra ventas desde la pantalla principal y aparecerán aquí." FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:SalesTicketRow">
                    <Border BackgroundColor="White" Stroke="{StaticResource SoftBorder}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 16" Padding="14,12" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding TimeDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
                                        <Label Text="{Binding OrderNumber}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding PaymentSummary}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding TotalDisplay}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource BrandDarkRed}" HorizontalTextAlignment="End" />
                                    <Border BackgroundColor="{Binding StatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="8,3" HorizontalOptions="End">
                                        <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" TextColor="White" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F3E4EA" />

                            <Label Text="{Binding ItemsSummary}" FontSize="13" TextColor="#5C6477" LineBreakMode="WordWrap" MaxLines="6" />

                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Button Text="🖨  Imprimir" Clicked="OnPrintClicked" CommandParameter="{Binding .}" HeightRequest="44"
                                        CornerRadius="12" FontSize="13" FontAttributes="Bold" BackgroundColor="#F2F3FF" TextColor="#3A4BC0"
                                        BorderColor="#DAE2FD" BorderWidth="1" SemanticProperties.Description="Imprimir o guardar comprobante" />
                                <Button Grid.Column="1" Text="Cancelar venta" Clicked="OnCancelClicked" CommandParameter="{Binding .}"
                                        IsVisible="{Binding CanCancel}" HeightRequest="44" CornerRadius="12" FontSize="13" FontAttributes="Bold"
                                        BackgroundColor="#FFDAD6" TextColor="#93000A" BorderColor="#F3B4AE" BorderWidth="1"
                                        SemanticProperties.Description="Cancelar esta venta" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4" Text="Las ventas se guardan automáticamente al cobrar. Imprime o cancela desde cada ticket."
               FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>