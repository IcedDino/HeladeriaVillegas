<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HeladeriaPOS.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:HeladeriaPOS.ViewModels"
    xmlns:models="clr-namespace:HeladeriaPOS.Models"
    x:DataType="vm:MainViewModel"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource PageBackground}">
    <ContentPage.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource SoftBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="18" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="CaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style x:Key="CartQuantityStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="#FFF4F7" />
            <Setter Property="TextColor" Value="{StaticResource BrandDarkRed}" />
            <Setter Property="BorderColor" Value="#E9B8C8" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
        <Style x:Key="PaymentChipStyle" TargetType="Button">
            <Setter Property="MinimumHeightRequest" Value="60" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderColor" Value="#E7C6D2" />
            <Setter Property="BorderWidth" Value="1.5" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#14000000" Offset="0,2" Radius="5" Opacity="0.4" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BillKeyStyle" TargetType="Button">
            <Setter Property="MinimumWidthRequest" Value="88" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="#FFF9FB" />
            <Setter Property="TextColor" Value="#512334" />
            <Setter Property="BorderColor" Value="#E7C6D2" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name='MainContent' ColumnDefinitions="4*,1*" ColumnSpacing="12" Margin="12">
       
        <Border Style="{StaticResource PanelStyle}" Padding="12">
            <Grid x:Name='Catalogue' RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout>
                        <Label Text="Heladería POS" FontSize="23" FontAttributes="Bold" />
                        <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Ventas" Clicked="OnSalesClicked" Style="{StaticResource TouchButtonStyle}" />
                    <Button Grid.Column="2" Text="Precios" Clicked="OnPricesClicked" Style="{StaticResource TouchButtonStyle}" />
                    <Button Grid.Column="3" Text="Respaldo" Clicked="OnBackupClicked" Style="{StaticResource TouchButtonStyle}" />
                </Grid>
                
                <!--Categories -->
                <Grid x:Name='Categories' Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Button Text="🍦  Helados" Grid.Column="0" HorizontalOptions="Fill" VerticalOptions="Fill" Style="{StaticResource CategoryButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Helados">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsHeladosSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandDarkRed}" /><Setter Property="TextColor" Value="White" />
                            </DataTrigger></Button.Triggers>
                    </Button>
                    <Button Text="🥨  Snacks" Grid.Column="1" HorizontalOptions="Fill" VerticalOptions="Fill" Style="{StaticResource CategoryButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Snacks">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsSnacksSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandDarkRed}" /><Setter Property="TextColor" Value="White" />
                            </DataTrigger></Button.Triggers>
                    </Button>
                    <Button Text="★  Especialidades" Grid.Column="2" HorizontalOptions="Fill" VerticalOptions="Fill" Style="{StaticResource CategoryButtonStyle}" Command="{Binding SelectCategoryCommand}" CommandParameter="Especialidades">
                            <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsEspecialidadesSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandDarkRed}" /><Setter Property="TextColor" Value="White" />
                            </DataTrigger></Button.Triggers>
                    </Button>
                </Grid>
                
                <!-- Catalogue -->
                <CollectionView x:Name="ProductCollectionView" Grid.Row="2" ItemsSource="{Binding FilteredProducts}" SelectionMode="None" ItemsUpdatingScrollMode="KeepScrollOffset">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout x:Name="ProductGridLayout" Orientation="Vertical" Span="8" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProductCardViewModel">
                            <Border x:Name="ProductCard" Style="{StaticResource PanelStyle}" Padding="0" Margin="2"
                                    Stroke="#EDD6DE" StrokeThickness="1"
                                    HeightRequest="{Binding BindingContext.ProductCardHeight, Source={RelativeSource AncestorType={x:Type ContentPage}}}">
                                    <Border.Shadow>
                                        <Shadow Brush="#220F0710" Offset="0,4" Radius="10" Opacity="0.5" />
                                    </Border.Shadow>
                                    <Border.Behaviors>
                                        <toolkit:TouchBehavior PressedScale="0.97" PressedOpacity="0.88" />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="*,Auto" InputTransparent="True">
                                        <Border HorizontalOptions="Fill" VerticalOptions="Fill"
                                                BackgroundColor="#F7EDF1" StrokeThickness="0" StrokeShape="RoundRectangle 17,17,0,0">
                                            <Grid>
                                                <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                                <Border HorizontalOptions="End" VerticalOptions="Start" Margin="10" Padding="10,6"
                                                        BackgroundColor="#E6FFFFFF" Stroke="#40FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                                                    <Label Text="{Binding BasePriceDisplay}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource BrandDarkRed}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,10">
                                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="#E5F6EF" StrokeThickness="0" Padding="8,5" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                                                <Label Text="{Binding Tag}" FontSize="10" FontAttributes="Bold" TextColor="#0B624A" MaxLines="1" LineBreakMode="TailTruncation" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                
            </Grid>
        </Border>
        
        <!-- Ticket / cuenta abierta -->
        <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="12">
            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="10">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding OrderNumber}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
                        <Border Grid.Column="1" BackgroundColor="#F2F3FF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,4" VerticalOptions="Center">
                            <Label Text="{Binding CartItemCountDisplay}" FontSize="11" FontAttributes="Bold" TextColor="#283044" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding Cart}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="Center" Padding="12">
                                <Label Text="Tu ticket está vacío" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#5C6477" />
                                <Label Text="Agrega un producto para comenzar" FontSize="12" HorizontalTextAlignment="Center" TextColor="#788093" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderItemViewModel">
                                <Border BackgroundColor="#F2F3FF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12" Margin="0,0,0,8">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding ProductName}" FontSize="15" FontAttributes="Bold" />
                                                <Label Text="{Binding Variant}" Style="{StaticResource CaptionStyle}" />
                                                <Label Text="{Binding ModifierSummary}" Style="{StaticResource CaptionStyle}" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding LineTotalDisplay}" FontSize="19" FontAttributes="Bold" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="44,36,44,*,44" ColumnSpacing="5">
                                            <Button Text="−" Style="{StaticResource CartQuantityStyle}" Command="{Binding DecrementQuantityCommand}" SemanticProperties.Description="Reducir cantidad" />
                                            <Label Grid.Column="1" Text="{Binding QuantityDisplay}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            <Button Grid.Column="2" Text="+" Style="{StaticResource CartQuantityStyle}" Command="{Binding IncrementQuantityCommand}" SemanticProperties.Description="Aumentar cantidad" />
                                            <Button Grid.Column="4" Text="×" Style="{StaticResource CartQuantityStyle}" Command="{Binding RemoveCommand}" BackgroundColor="#FFDAD6" TextColor="#93000A" SemanticProperties.Description="Eliminar producto" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="RESUMEN DE VENTA" FontSize="11" CharacterSpacing="1" FontAttributes="Bold" TextColor="#5C6477" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Subtotal base" FontSize="13" TextColor="#5C6477" />
                                <Label Grid.Column="1" Text="{Binding SubtotalBaseDisplay}" FontSize="16" FontAttributes="Bold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Extras y toppings" FontSize="13" TextColor="#5C6477" />
                                <Label Grid.Column="1" Text="{Binding TotalExtrasDisplay}" FontSize="15" FontAttributes="Bold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,90" ColumnSpacing="6">
                                <Label Text="Descuento" FontSize="13" TextColor="{StaticResource CheckoutGreen}" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="#F2F3FF" StrokeThickness="0" StrokeShape="RoundRectangle 10" MinimumHeightRequest="44">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDiscountTapped" /></Border.GestureRecognizers>
                                    <Label x:Name="DiscountEntry" Text="{Binding DiscountInput, StringFormat='$ {0}'}" FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="End" Padding="12,0" VerticalTextAlignment="Center"
                                           SemanticProperties.Description="Descuento en pesos. Toca para abrir el teclado numérico." />
                                </Border>
                            </Grid>
                            <Entry Text="{Binding DiscountReason, Mode=TwoWay}" Placeholder="Motivo del descuento" Style="{StaticResource TouchEntryStyle}" FontSize="14" IsVisible="True" />
                            <BoxView HeightRequest="1" Color="#DAE2FD" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Label Text="TOTAL A PAGAR" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Label Text="{Binding TotalDisplay}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" HorizontalTextAlignment="End" />
                                    <Label Text="MXN" FontSize="10" TextColor="#5C6477" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E8E9F3" />
                            <Grid ColumnDefinitions="*,1.6*" ColumnSpacing="6">
                                <Button Text="Cancelar" Clicked="OnCancelOrderClicked" BackgroundColor="#FFDAD6" TextColor="#93000A" HeightRequest="52" FontSize="13" />
                                <Border Grid.Column="1" HeightRequest="52" BackgroundColor="#FFF0F3" Stroke="{StaticResource BrandRed}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12" SemanticProperties.Description="Abrir órdenes en espera">
                                    <Border.Behaviors>
                                        <toolkit:TouchBehavior PressedScale="0.96" PressedOpacity="0.85" />
                                    </Border.Behaviors>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenHeldOrdersClicked" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="12,0">
                                        <Grid WidthRequest="26" HeightRequest="26" VerticalOptions="Center">
                                            <Border WidthRequest="18" HeightRequest="15" HorizontalOptions="End" VerticalOptions="Start"
                                                    BackgroundColor="#F9B8C8" StrokeThickness="0" StrokeShape="RoundRectangle 4" />
                                            <Border WidthRequest="18" HeightRequest="15" HorizontalOptions="Center" VerticalOptions="Center"
                                                    BackgroundColor="#F48FA7" StrokeThickness="0" StrokeShape="RoundRectangle 4" />
                                            <Border WidthRequest="18" HeightRequest="15" HorizontalOptions="Start" VerticalOptions="End"
                                                    BackgroundColor="{StaticResource BrandRed}" StrokeThickness="0" StrokeShape="RoundRectangle 4" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="En espera" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandDarkRed}" />
                                            <Label Text="{Binding HeldOrderCountDisplay}" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                                BackgroundColor="{StaticResource BrandRed}" VerticalOptions="Center">
                                            <Label Text="{Binding HeldOrderCount}" FontSize="15" FontAttributes="Bold" TextColor="White"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Button Text="Deshacer cancelación" Clicked="OnUndoOrderClicked" IsVisible="{Binding CanUndoClear}" HeightRequest="48" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <BoxView Grid.Row="1" HeightRequest="1" Color="#E8E9F3" />

                <Button Grid.Row="2" Text="💵  Cobrar" Clicked="OnOpenPaymentClicked" HeightRequest="68" CornerRadius="14" FontSize="19" FontAttributes="Bold"
                        BackgroundColor="{StaticResource CheckoutGreen}" TextColor="White" Padding="12,0" SemanticProperties.Description="Abrir el cobro del ticket" />
            </Grid>
        </Border>
        
        <Grid x:Name="NumericKeypadOverlay" Grid.ColumnSpan="2" ZIndex="200" IsVisible="False" BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnKeypadBackdropTapped" />
            </Grid.GestureRecognizers>

            <Border WidthRequest="390" Padding="20" BackgroundColor="White" Stroke="#E8E9F3" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnKeypadPanelTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="KeypadTitle" Text="EFECTIVO RECIBIDO" FontSize="13" CharacterSpacing="1" FontAttributes="Bold" TextColor="#5C6477" />
                    <Label Text="{Binding ReceivedCashInput, StringFormat='${0}'}" FontSize="38" FontAttributes="Bold"
                           HorizontalTextAlignment="End" TextColor="{StaticResource BrandRed}" />

                    <Grid RowDefinitions="64,64,64,64" ColumnDefinitions="*,*,*" RowSpacing="10" ColumnSpacing="10">
                        <Button Text="1" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="2" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Column="2" Text="3" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="1" Text="4" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="2" Text="7" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="3" Text="." Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="3" Grid.Column="1" Text="0" Clicked="OnKeypadNumberClicked" FontSize="24" FontAttributes="Bold" />
                        <Button Grid.Row="3" Grid.Column="2" Text="⌫" Clicked="OnKeypadBackspaceClicked" FontSize="24" FontAttributes="Bold"
                                SemanticProperties.Description="Borrar último número" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Borrar" Clicked="OnKeypadClearClicked" HeightRequest="58" CornerRadius="12"
                                BackgroundColor="#FFDAD6" TextColor="#93000A" FontSize="17" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="Listo" Clicked="OnKeypadDoneClicked" HeightRequest="58" CornerRadius="12"
                                BackgroundColor="{StaticResource CheckoutGreen}" TextColor="White" FontSize="17" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="AddProductOverlay" Grid.ColumnSpan="2" ZIndex="110" IsVisible="False" BackgroundColor="#80000000">
            <Border Margin="12" MaximumWidthRequest="1060" MaximumHeightRequest="700" HorizontalOptions="Fill" VerticalOptions="Fill"
                    BackgroundColor="White" Stroke="#E8E9F3" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Grid Padding="26" RowDefinitions="Auto,*,Auto" RowSpacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Agregar producto" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
                            <Label Text="Completa los datos y elige una foto" FontSize="15" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×" Clicked="OnCancelAddProductClicked" WidthRequest="56" HeightRequest="56"
                                CornerRadius="28" Padding="0" FontSize="28" BackgroundColor="#FFF0F3" TextColor="{StaticResource BrandDarkRed}"
                                SemanticProperties.Description="Cerrar formulario" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <Grid ColumnDefinitions="1.08*,0.92*" ColumnSpacing="26">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="DATOS PRINCIPALES" FontSize="12" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="Categoría" FontSize="16" FontAttributes="Bold" />
                                <Picker x:Name="NewProductCategory" Title="Selecciona una categoría" SelectedIndex="0" HeightRequest="56"
                                        BackgroundColor="#FFF9FB">
                                    <Picker.Items>
                                        <x:String>Helados</x:String>
                                        <x:String>Snacks</x:String>
                                        <x:String>Especialidades</x:String>
                                    </Picker.Items>
                                </Picker>

                                <Label Text="Nombre" FontSize="16" FontAttributes="Bold" />
                                <Entry x:Name="NewProductName" Placeholder="Ej. Sundae de fresa" Style="{StaticResource TouchEntryStyle}"
                                       MinimumHeightRequest="56" FontSize="19" MaxLength="120" />

                                <Label Text="Foto del producto" FontSize="16" FontAttributes="Bold" />
                                <Border HeightRequest="175" BackgroundColor="#F7EDF1" Stroke="#E7C6D2" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                                    <Image x:Name="NewProductImagePreview" Source="placeholder.png" Aspect="AspectFill" />
                                </Border>
                                <Button Text="Elegir de la biblioteca" Clicked="OnOpenversePickerClicked" HeightRequest="56" CornerRadius="14"
                                        BackgroundColor="#FFF0F3" TextColor="{StaticResource BrandRed}" BorderColor="#EBA8BD" BorderWidth="2"
                                        FontAttributes="Bold" FontSize="16" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Text="Tomar foto" Clicked="OnTakeProductPhotoClicked" HeightRequest="54" CornerRadius="13"
                                            BackgroundColor="#FFF9FB" TextColor="#512334" BorderColor="#E7C6D2" BorderWidth="1"
                                            FontAttributes="Bold" FontSize="15" />
                                    <Button Grid.Column="1" Text="Elegir archivo" Clicked="OnChooseProductPhotoClicked" HeightRequest="54" CornerRadius="13"
                                            BackgroundColor="#FFF9FB" TextColor="#512334" BorderColor="#E7C6D2" BorderWidth="1"
                                            FontAttributes="Bold" FontSize="15" />
                                </Grid>
                                <Label x:Name="NewProductImageAttribution" Text="Ninguna foto seleccionada" FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="14">
                                <Label Text="VENTA Y OPCIONES" FontSize="12" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="Precio base" FontSize="16" FontAttributes="Bold" />
                                    <Border BackgroundColor="#FFF9FB" Stroke="#E7C6D2" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnBasePriceTapped" />
                                        </Border.GestureRecognizers>
                                        <Label x:Name="NewProductPrice" Text="0.00" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                                               Padding="14,20" SemanticProperties.Description="Precio base. Toca para abrir el teclado numérico." />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="Etiqueta" FontSize="16" FontAttributes="Bold" />
                                    <Entry x:Name="NewProductTag" Placeholder="Ej. Temporada" Style="{StaticResource TouchEntryStyle}"
                                           MinimumHeightRequest="56" FontSize="18" MaxLength="50" />
                                </VerticalStackLayout>

                                <Border BackgroundColor="#FFF6F8" Stroke="#E7C6D2" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="64">
                                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                            <Label Text="Permitir extras" FontSize="18" FontAttributes="Bold" />
                                            <Label Text="El cajero podrá indicar cuántos desea" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Switch x:Name="NewProductAllowsExtras" Grid.Column="1" Scale="1.4" VerticalOptions="Center"
                                                Toggled="OnNewProductAllowsExtrasToggled" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout x:Name="NewProductExtrasFields" IsVisible="False" Spacing="12">
                                    <VerticalStackLayout Spacing="7">
                                        <Label Text="Nombre del extra" FontSize="16" FontAttributes="Bold" />
                                        <Entry x:Name="NewProductExtraName" Placeholder="Ej. Topping extra" Style="{StaticResource TouchEntryStyle}"
                                               MinimumHeightRequest="56" FontSize="18" MaxLength="80" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="7">
                                        <Label Text="Precio por extra" FontSize="16" FontAttributes="Bold" />
                                        <Border BackgroundColor="#FFF9FB" Stroke="#E7C6D2" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnExtraPriceTapped" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="NewProductExtraPrice" Text="0.00" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                                                   Padding="14,20" SemanticProperties.Description="Precio por extra. Toca para abrir el teclado numérico." />
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <Border x:Name="AddProductErrorPanel" BackgroundColor="#FFF0EE" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12" Padding="12" IsVisible="False">
                                    <Label x:Name="AddProductErrorText" TextColor="#93000A" FontSize="14" LineBreakMode="WordWrap" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </ScrollView>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Button Text="Cancelar" Clicked="OnCancelAddProductClicked" HeightRequest="64" CornerRadius="16"
                                BackgroundColor="#F3ECEF" TextColor="#512334" FontSize="18" FontAttributes="Bold" />
                        <Button x:Name="SaveProductButton" Grid.Column="1" Text="Guardar producto" Clicked="OnSaveProductClicked"
                                HeightRequest="64" CornerRadius="16" BackgroundColor="{StaticResource CheckoutGreen}"
                                TextColor="White" FontSize="18" FontAttributes="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="OpenverseGalleryOverlay" Grid.ColumnSpan="2" ZIndex="120" IsVisible="False" BackgroundColor="#A0000000">
            <Border Margin="48" Padding="22" BackgroundColor="White" Stroke="#E8E9F3" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20" HorizontalOptions="Fill" VerticalOptions="Fill">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Biblioteca de productos" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
                            <Label Text="Fotos guardadas localmente y disponibles sin internet" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×" Clicked="OnCloseOpenverseClicked" WidthRequest="48" HeightRequest="48"
                                CornerRadius="24" Padding="0" FontSize="25" BackgroundColor="#F2F3FF" TextColor="#283044" />
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Spacing="10">
                        <HorizontalStackLayout Spacing="9">
                            <Button Text="Todos" CommandParameter="Todos" Clicked="OnOpenverseCategoryClicked" Style="{StaticResource QuickCashButtonStyle}" />
                            <Button Text="Helados" CommandParameter="Helados" Clicked="OnOpenverseCategoryClicked" Style="{StaticResource QuickCashButtonStyle}" />
                            <Button Text="Snacks" CommandParameter="Snacks" Clicked="OnOpenverseCategoryClicked" Style="{StaticResource QuickCashButtonStyle}" />
                            <Button Text="Especialidades" CommandParameter="Especialidades" Clicked="OnOpenverseCategoryClicked" Style="{StaticResource QuickCashButtonStyle}" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry x:Name="OpenverseSearchEntry" Placeholder="Si no está, busca una foto en internet" Style="{StaticResource TouchEntryStyle}" ReturnType="Search" Completed="OnOpenverseSearchCompleted" />
                            <Button Grid.Column="1" Text="Buscar en internet" Clicked="OnOpenverseSearchClicked" WidthRequest="170" CornerRadius="12"
                                    BackgroundColor="{StaticResource BrandRed}" TextColor="White" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>

                    <Grid Grid.Row="2">
                        <CollectionView x:Name="OpenverseResultsView" SelectionMode="Single" SelectionChanged="OnOpenverseImageSelected">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:OpenverseImageResult">
                                    <Border HeightRequest="205" Padding="8" BackgroundColor="#FFF9FB" Stroke="#E7C6D2" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                        <Border.Behaviors>
                                            <toolkit:TouchBehavior PressedScale="0.96" PressedOpacity="0.85" />
                                        </Border.Behaviors>
                                        <Grid RowDefinitions="*,Auto" RowSpacing="6">
                                            <Border BackgroundColor="#F7EDF1" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                                <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                            </Border>
                                            <Label Grid.Row="1" Text="{Binding DisplayTitle}" FontSize="12" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <VerticalStackLayout x:Name="OpenverseLoadingPanel" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource BrandRed}" WidthRequest="42" HeightRequest="42" />
                            <Label Text="Buscando imágenes…" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <Label x:Name="OpenverseStatusText" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center"
                               FontSize="15" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Payment popup -->
        <Grid x:Name="PaymentOverlay" Grid.ColumnSpan="2" ZIndex="150" IsVisible="False" BackgroundColor="#B0000000">
            <Border Margin="32" Padding="24" BackgroundColor="White" Stroke="#E8E9F3" StrokeThickness="1"
                    HorizontalOptions="Fill" VerticalOptions="Fill">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#55000000" Offset="0,10" Radius="24" Opacity="0.6" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Cobrar orden" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
                            <Label Text="{Binding OrderNumber}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×" Clicked="OnClosePaymentClicked" WidthRequest="52" HeightRequest="52"
                                CornerRadius="26" Padding="0" FontSize="26" BackgroundColor="#FFF0F3" TextColor="{StaticResource BrandDarkRed}"
                                SemanticProperties.Description="Cerrar cobro" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="22">
                        <!-- Left: datos de pago -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Método de pago" FontSize="15" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="58,58" ColumnSpacing="10" RowSpacing="10">
                                <Button Text="Efectivo" Style="{StaticResource PaymentChipStyle}" Command="{Binding SelectPaymentCommand}" CommandParameter="Cash">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCashSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandRed}" /><Setter Property="TextColor" Value="White" /><Setter Property="BorderColor" Value="{StaticResource BrandRed}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="1" Text="Tarjeta" Style="{StaticResource PaymentChipStyle}" Command="{Binding SelectPaymentCommand}" CommandParameter="Card">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCardSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandRed}" /><Setter Property="TextColor" Value="White" /><Setter Property="BorderColor" Value="{StaticResource BrandRed}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Row="1" Text="Transferencia" Style="{StaticResource PaymentChipStyle}" Command="{Binding SelectPaymentCommand}" CommandParameter="Transfer">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsTransferSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandRed}" /><Setter Property="TextColor" Value="White" /><Setter Property="BorderColor" Value="{StaticResource BrandRed}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Text="Mixto" Style="{StaticResource PaymentChipStyle}" Command="{Binding SelectPaymentCommand}" CommandParameter="Mixed">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsMixedPayment}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandRed}" /><Setter Property="TextColor" Value="White" /><Setter Property="BorderColor" Value="{StaticResource BrandRed}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>

                            <Border IsVisible="{Binding IsCashPayment}" BackgroundColor="#F2F3FF" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Efectivo recibido" Style="{StaticResource CaptionStyle}" />
                                    <Border BackgroundColor="White" Stroke="#E7C6D2" StrokeThickness="1.5" StrokeShape="RoundRectangle 12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnReceivedCashTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" Padding="14,10">
                                            <Label Text="{Binding ReceivedCashInput, StringFormat='$ {0}'}" FontSize="26" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center"
                                                   SemanticProperties.Description="Efectivo recibido en pesos. Toca para abrir el teclado numérico." />
                                            <Label Grid.Column="1" Text="⌨" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>

                                    <Label Text="BILLETES" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" TextColor="#5C6477" />
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="50,50" ColumnSpacing="8" RowSpacing="8">
                                        <Button Text="Exacto" Style="{StaticResource BillKeyStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="Exacto" BackgroundColor="#DDF8EA" TextColor="#006C4A" />
                                        <Button Grid.Column="1" Text="+$20" Style="{StaticResource BillKeyStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="20" />
                                        <Button Grid.Column="2" Text="+$50" Style="{StaticResource BillKeyStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="50" />
                                        <Button Grid.Row="1" Text="+$100" Style="{StaticResource BillKeyStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="100" />
                                        <Button Grid.Row="1" Grid.Column="1" Text="+$200" Style="{StaticResource BillKeyStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="200" />
                                        <Button Grid.Row="1" Grid.Column="2" Text="+$500" Style="{StaticResource BillKeyStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="500" />
                                    </Grid>
                                    <Button Text="Limpiar efectivo" Command="{Binding ApplyQuickCashCommand}" CommandParameter="Limpiar" HeightRequest="44"
                                            CornerRadius="12" FontSize="14" FontAttributes="Bold" BackgroundColor="#FFDAD6" TextColor="#93000A" />
                                </VerticalStackLayout>
                            </Border>

                            <Border IsVisible="{Binding IsCardUsed}" BackgroundColor="#FFF4F7" Stroke="{StaticResource SoftBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Importe con tarjeta" Style="{StaticResource CaptionStyle}" />
                                    <Border BackgroundColor="White" Stroke="#E7C6D2" StrokeThickness="1.5" StrokeShape="RoundRectangle 12">
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCardTapped" /></Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" Padding="14,10">
                                            <Label Text="{Binding CardInput, StringFormat='$ {0}'}" FontSize="24" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center"
                                                   SemanticProperties.Description="Importe con tarjeta. Toca para abrir el teclado numérico." />
                                            <Label Grid.Column="1" Text="⌨" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border IsVisible="{Binding IsTransferUsed}" BackgroundColor="#FFF4F7" Stroke="{StaticResource SoftBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Importe por transferencia" Style="{StaticResource CaptionStyle}" />
                                    <Border BackgroundColor="White" Stroke="#E7C6D2" StrokeThickness="1.5" StrokeShape="RoundRectangle 12">
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransferTapped" /></Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" Padding="14,10">
                                            <Label Text="{Binding TransferInput, StringFormat='$ {0}'}" FontSize="24" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" VerticalTextAlignment="Center"
                                                   SemanticProperties.Description="Importe por transferencia. Toca para abrir el teclado numérico." />
                                            <Label Grid.Column="1" Text="⌨" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Right: resumen y acciones -->
                        <Border Grid.Column="1" BackgroundColor="#FDF2F6" Stroke="#F3D9E2" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="18,16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="TOTAL DE LA VENTA" FontSize="11" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding TotalDisplay}" FontSize="40" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
                                    <Label Grid.Column="1" Text="MXN" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="End" Margin="0,0,0,8" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0E3E8" />

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Label Text="Subtotal base" FontSize="13" TextColor="#5C6477" />
                                    <Label Grid.Column="1" Text="{Binding SubtotalBaseDisplay}" FontSize="15" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Text="Extras y toppings" FontSize="13" TextColor="#5C6477" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalExtrasDisplay}" FontSize="15" FontAttributes="Bold" />
                                    <Label Grid.Row="2" Text="Descuento" FontSize="13" TextColor="{StaticResource CheckoutGreen}" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding DiscountDisplay}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource CheckoutGreen}" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0E3E8" />

                                <Border IsVisible="{Binding IsCashPayment}" BackgroundColor="White" Stroke="#E7C6D2" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="Cambio a entregar" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource CheckoutGreen}" />
                                            <Label Text="Efectivo recibido" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                                            <Label Text="{Binding ChangeDisplay}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource CheckoutGreen}" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding ReceivedCashInput, StringFormat='Recibido $ {0}'}" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <BoxView HeightRequest="1" Color="#F0E3E8" />

                                <Label Text="{Binding CheckoutHint}" FontSize="13" TextColor="#8A5060" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

                                <Grid ColumnDefinitions="*,1.6*" ColumnSpacing="10">
                                    <Button Text="Cancelar" Clicked="OnClosePaymentClicked" HeightRequest="56" CornerRadius="14" FontSize="15" FontAttributes="Bold"
                                            BackgroundColor="#EEEEEE" TextColor="#444444" />
                                    <Button Grid.Column="1" Text="Registrar venta" Command="{Binding CheckoutCommand}" HeightRequest="56" CornerRadius="14"
                                            FontSize="15" FontAttributes="Bold" BackgroundColor="{StaticResource CheckoutGreen}" TextColor="White"
                                            SemanticProperties.Description="Registrar la venta y vaciar el ticket">
                                        <Button.Triggers>
                                            <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                                <Setter Property="BackgroundColor" Value="#D6EAE1" /><Setter Property="TextColor" Value="#537565" />
                                            </Trigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Held orders popup -->
        <Grid x:Name="HeldOrdersOverlay" Grid.ColumnSpan="2" ZIndex="140" IsVisible="False" BackgroundColor="#B0000000">
            <Border WidthRequest="560" MaximumHeightRequest="760" Padding="24" BackgroundColor="White" Stroke="#E8E9F3" StrokeThickness="1"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#55000000" Offset="0,10" Radius="24" Opacity="0.6" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Órdenes en espera" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
                            <Label Text="{Binding HeldOrderCountDisplay}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×" Clicked="OnCloseHeldOrdersClicked" WidthRequest="50" HeightRequest="50"
                                CornerRadius="25" Padding="0" FontSize="24" BackgroundColor="#FFF0F3" TextColor="{StaticResource BrandDarkRed}"
                                SemanticProperties.Description="Cerrar órdenes en espera" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding HeldOrders}" SelectionMode="None" VerticalScrollBarVisibility="Never">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="8" Padding="0,30" VerticalOptions="Center">
                                <Label Text="No hay órdenes en espera" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                                <Label Text="Cuando pongas una orden en espera, aparecerá aquí apilada." FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeldOrderSummary">
                                <Border BackgroundColor="#FFF0F3" Stroke="#F3D9E2" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                        <VerticalStackLayout Grid.ColumnSpan="2" Spacing="2">
                                            <Label Text="{Binding OrderNumber}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource BrandDarkRed}" />
                                            <Label Text="{Binding ItemCountDisplay}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Row="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="TOTAL" FontSize="10" CharacterSpacing="1" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                                            <Label Text="{Binding TotalDisplay}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
                                        </VerticalStackLayout>
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="46,116" ColumnSpacing="8">
                                            <Button Text="🗑" Clicked="OnDeleteHeldClicked" CommandParameter="{Binding OrderNumber}" HeightRequest="46"
                                                    CornerRadius="12" FontSize="17" BackgroundColor="#FFDAD6" TextColor="#93000A"
                                                    SemanticProperties.Description="Eliminar orden en espera" />
                                            <Button Grid.Column="1" Text="Abrir" Clicked="OnRestoreHeldFromOverlayClicked" CommandParameter="{Binding OrderNumber}" HeightRequest="46"
                                                    CornerRadius="12" FontSize="14" FontAttributes="Bold" BackgroundColor="{StaticResource CheckoutGreen}" TextColor="White"
                                                    SemanticProperties.Description="Abrir esta orden en el ticket" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Grid.Row="2" Text="Toca «Abrir» en cualquier orden de la pila para traerla al ticket, o elimínala con la papelera." FontSize="12"
                           TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
    
</ContentPage>
