<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HeladeriaPOS.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:HeladeriaPOS.ViewModels"
    x:DataType="vm:MainViewModel"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="64*,36*">
        <!-- CATÁLOGO -->
        <Grid Grid.Column="0" Padding="26,22,18,22" RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="White">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Heladería POS" FontSize="32" FontAttributes="Bold" />
                    <Label Text="Toca una categoría y luego un producto" FontSize="16" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Nuevo ticket"
                        ImageSource="icon_new_ticket.png"
                        Style="{StaticResource TouchButtonStyle}"
                        Command="{Binding NewTicketCommand}"
                        BackgroundColor="#FFF4F4"
                        TextColor="#B71C1C"
                        BorderColor="#F3CCCC"
                        BorderWidth="1" />
            </Grid>

            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,20">
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Snacks"
                            ImageSource="icon_category_snacks.png"
                            Style="{StaticResource CategoryButtonStyle}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Snacks">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSnacksSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandRed}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandRed}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="Helados"
                            ImageSource="icon_category_helados.png"
                            Style="{StaticResource CategoryButtonStyle}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Helados">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsHeladosSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandRed}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandRed}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="Especialidades"
                            ImageSource="icon_category_especialidades.png"
                            Style="{StaticResource CategoryButtonStyle}"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Especialidades">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsEspecialidadesSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandRed}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandRed}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>

            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding FilteredProducts}"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepScrollOffset">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductCardViewModel">
                        <Border Stroke="#E6E8EA" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="2" MinimumHeightRequest="286">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <Border BackgroundColor="#A8E6CF" Padding="9,4" HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Tag}" FontSize="11" FontAttributes="Bold" TextColor="#35443F" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding BasePriceDisplay}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" VerticalOptions="Center" />
                                </Grid>

                                <Border Grid.Row="1" BackgroundColor="#FAFAFA" MinimumHeightRequest="180">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                </Border>

                                <Label Grid.Row="2" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Grid.Row="3" BackgroundColor="#F8FAFC" Stroke="#E6ECF2" StrokeThickness="1" Padding="10,8" Margin="2,14,2,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" WidthRequest="20" HeightRequest="20" Color="{StaticResource BrandRed}" />
                    <Label Grid.Column="1" Text="{Binding StatusMessage}" FontSize="14" TextColor="#606A73" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                </Grid>
            </Border>
        </Grid>

        <!-- COBRO -->
        <Grid Grid.Column="1" Padding="20" RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PanelBackground}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Ticket Activo" FontSize="28" FontAttributes="Bold" />
                    <Label Text="Zona de cobro táctil" FontSize="14" TextColor="#858585" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Border BackgroundColor="#FDE7E7" Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding OrderNumber}" FontSize="11" FontAttributes="Bold" TextColor="#C62828" />
                    </Border>
                    <Button Text="Vaciar"
                            Style="{StaticResource TouchButtonStyle}"
                            Command="{Binding ClearCartCommand}"
                            BackgroundColor="#FFF7E8"
                            TextColor="#8A5200"
                            BorderColor="#F4D4A2"
                            BorderWidth="1" />
                </HorizontalStackLayout>
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Cart}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderItemViewModel">
                        <Border Stroke="#E3E5E8" StrokeThickness="1" BackgroundColor="White" Padding="14" Margin="0,0,0,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding ProductName}" FontSize="18" FontAttributes="Bold" />
                                        <Label Text="{Binding Variant}" FontSize="13" TextColor="#6F6F6F" />
                                        <Label Text="{Binding ModifierSummary}" FontSize="12" TextColor="#8A8A8A" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                        <Label Text="{Binding UnitPriceDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding LineTotalDisplay}" FontSize="19" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                                    <Button Text="−" Style="{StaticResource QuantityButtonStyle}" Command="{Binding DecrementQuantityCommand}" />
                                    <Border Grid.Column="1" BackgroundColor="#F2F4F6" Stroke="#D8DDE2" StrokeThickness="1" MinimumWidthRequest="56" HeightRequest="52">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding QuantityDisplay}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="2" Text="+" Style="{StaticResource QuantityButtonStyle}" Command="{Binding IncrementQuantityCommand}" />
                                    <Label Grid.Column="3" Text="Cantidad" FontSize="12" TextColor="#8B939B" VerticalTextAlignment="Center" Margin="6,0,0,0" />
                                    <Button Grid.Column="4"
                                            ImageSource="icon_delete.png"
                                            Style="{StaticResource TouchButtonStyle}"
                                            Command="{Binding RemoveCommand}"
                                            WidthRequest="58"
                                            BackgroundColor="#FFF0F0"
                                            TextColor="#C62828"
                                            BorderColor="#F1C6C6"
                                            BorderWidth="1" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Grid.Row="2" Margin="0,12,0,0" BackgroundColor="White" Stroke="#E3E5E8" StrokeThickness="1" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Subtotal base" FontSize="15" TextColor="#666666" />
                        <Label Grid.Column="1" Text="{Binding SubtotalBaseDisplay}" FontSize="15" FontAttributes="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Extras y toppings" FontSize="15" TextColor="#666666" />
                        <Label Grid.Column="1" Text="{Binding TotalExtrasDisplay}" FontSize="15" FontAttributes="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,130" ColumnSpacing="8">
                        <Label Text="Descuento" FontSize="15" TextColor="#666666" VerticalTextAlignment="Center" />
                        <Entry Grid.Column="1" Text="{Binding DiscountInput, Mode=TwoWay}" Keyboard="Numeric" Style="{StaticResource TouchEntryStyle}" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#ECECEC" Margin="0,3" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="TOTAL A PAGAR" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource BrandDarkRed}" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="31" FontAttributes="Bold" TextColor="#B71C1C" />
                    </Grid>

                    <Label Text="Recibido (Efectivo)" FontSize="16" FontAttributes="Bold" Margin="0,4,0,0" />
                    <Entry Text="{Binding ReceivedCashInput, Mode=TwoWay}" Keyboard="Numeric" Placeholder="0.00" Style="{StaticResource TouchEntryStyle}" />

                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Margin="0,4,0,0">
                        <Button Text="Exacto" Style="{StaticResource QuickCashButtonStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="Exacto" Margin="0,0,7,7" />
                        <Button Text="+$20" Style="{StaticResource QuickCashButtonStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="20" Margin="0,0,7,7" />
                        <Button Text="+$50" Style="{StaticResource QuickCashButtonStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="50" Margin="0,0,7,7" />
                        <Button Text="+$100" Style="{StaticResource QuickCashButtonStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="100" Margin="0,0,7,7" />
                        <Button Text="+$200" Style="{StaticResource QuickCashButtonStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="200" Margin="0,0,7,7" />
                        <Button Text="+$500" Style="{StaticResource QuickCashButtonStyle}" Command="{Binding ApplyQuickCashCommand}" CommandParameter="500" Margin="0,0,7,7" />
                        <Button Text="Limpiar"
                                Style="{StaticResource QuickCashButtonStyle}"
                                Command="{Binding ApplyQuickCashCommand}"
                                CommandParameter="Limpiar"
                                Margin="0,0,7,7"
                                BackgroundColor="#FFF3F3"
                                TextColor="#9B2C2C"
                                BorderColor="#F1CACA" />
                    </FlexLayout>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <Label Text="Cambio a entregar" FontSize="16" FontAttributes="Bold" TextColor="#257347" />
                        <Label Grid.Column="1" Text="{Binding ChangeDisplay}" FontSize="25" FontAttributes="Bold" TextColor="#138A50" />
                    </Grid>

                    <Button Text="Cobrar &amp; Registrar"
                            ImageSource="icon_checkout.png"
                            Command="{Binding CheckoutCommand}"
                            HeightRequest="64"
                            CornerRadius="12"
                            FontSize="19"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource CheckoutGreen}"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
